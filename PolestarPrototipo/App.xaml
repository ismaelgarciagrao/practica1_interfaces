<Application x:Class="PolestarPrototipo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- =====================================================================
             COLORES (15 SolidColorBrush). Se usan siempre por nombre, nunca en
             hexadecimal dentro de las pantallas: así un cambio de color se hace aquí.
             Las combinaciones texto/fondo se comprueban con herramientas/contraste.py
             ===================================================================== -->
        <SolidColorBrush x:Key="ColorFondo"            Color="#F4F4F2"/> <!-- fondo de la ventana -->
        <SolidColorBrush x:Key="ColorBlanco"           Color="#FFFFFF"/> <!-- tarjetas, campos, texto sobre oscuro -->
        <SolidColorBrush x:Key="ColorCabecera"         Color="#121212"/> <!-- cabecera con logotipo y menú -->
        <SolidColorBrush x:Key="ColorTexto"            Color="#1A1A1A"/> <!-- texto principal y pie -->
        <SolidColorBrush x:Key="ColorTextoSecundario"  Color="#595959"/> <!-- texto de apoyo -->
        <SolidColorBrush x:Key="ColorTextoSobreOscuro" Color="#BDBDBD"/> <!-- texto secundario sobre fondos oscuros -->
        <SolidColorBrush x:Key="ColorAcento"           Color="#A85400"/> <!-- botón principal, precios -->
        <SolidColorBrush x:Key="ColorAcentoOscuro"     Color="#8A4500"/> <!-- botón principal al pasar el ratón -->
        <SolidColorBrush x:Key="ColorNaranja"          Color="#E8862A"/> <!-- línea de pantalla activa, detalles sobre oscuro -->
        <SolidColorBrush x:Key="ColorBorde"            Color="#D6D6D2"/> <!-- bordes de tarjeta, botón desactivado -->
        <SolidColorBrush x:Key="ColorBordeCampo"       Color="#8A8A86"/> <!-- borde de los campos de texto -->
        <SolidColorBrush x:Key="ColorBanner"           Color="#1E2A33"/> <!-- fondo del banner y etiqueta "Nuevo" -->
        <SolidColorBrush x:Key="ColorFondoImagen"      Color="#ECECE8"/> <!-- fondo de la imagen de cada tarjeta -->
        <SolidColorBrush x:Key="ColorError"            Color="#B3261E"/> <!-- texto y borde de error -->
        <SolidColorBrush x:Key="ColorFondoError"       Color="#FCEDEC"/> <!-- fondo de error -->

        <!-- =====================================================================
             ESTILOS (14)
             ===================================================================== -->

        <!-- 1-5. Textos: definen la jerarquía visual (título > sección > normal > secundario) -->
        <Style x:Key="TextoTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TextoSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TextoNormal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TextoSecundario" TargetType="TextBlock" BasedOn="{StaticResource TextoNormal}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
        </Style>

        <Style x:Key="TextoPrecio" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorAcento}"/>
        </Style>

        <!-- 6. Etiqueta de los campos del formulario (Label permite tecla de acceso con Alt) -->
        <Style x:Key="TextoEtiquetaCampo" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <!-- 7. Etiqueta pequeña tipo "Nuevo" / "Oferta" -->
        <Style x:Key="Etiqueta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorBanner}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="TextElement.FontSize" Value="12"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 8. Tarjeta de producto: mismo aspecto en Inicio y en Galería -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
        </Style>

        <!-- 9. Imagen de la tarjeta -->
        <Style x:Key="ImagenTarjeta" TargetType="Image">
            <Setter Property="Height" Value="150"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- 10. Botón del menú. La línea inferior usa BorderBrush: por defecto es transparente
             y el código (MostrarPantalla) la pone en ColorNaranja en la pantalla activa. -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordeFoco" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Height="3" VerticalAlignment="Bottom" Margin="14,0,14,8"
                                        Background="{TemplateBinding BorderBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ColorNaranja}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BordeFoco" Property="BorderBrush" Value="{StaticResource ColorBlanco}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 11. Botón que envuelve el logotipo (vuelve a Inicio) -->
        <Style x:Key="BotonLogo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BordeFoco" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" Padding="6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BordeFoco" Property="BorderBrush" Value="{StaticResource ColorBlanco}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 12. Botón de acción principal -->
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <!-- Anillo de foco interior: visible sobre fondos claros y oscuros -->
                                <Border x:Name="AnilloFoco" Margin="3" CornerRadius="3"
                                        BorderBrush="Transparent" BorderThickness="2"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorAcentoOscuro}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorAcentoOscuro}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AnilloFoco" Property="BorderBrush" Value="{StaticResource ColorBlanco}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource ColorBorde}"/>
                                <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 13. Campo de texto. En caso de error, el código pone BorderBrush = ColorError y
             Background = ColorFondoError; al corregirlo usa ClearValue y vuelve a este estilo. -->
        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="Background" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBordeCampo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ColorAcento}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ColorFondoImagen}"/>
                    <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 14. Campo de contraseña: mismo aspecto que CampoTexto, pero oculta los caracteres -->
        <Style x:Key="CampoContrasena" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="Background" Value="{StaticResource ColorBlanco}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBordeCampo}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ColorAcento}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ColorFondoImagen}"/>
                    <Setter Property="Foreground" Value="{StaticResource ColorTextoSecundario}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
